<brls:Box
        width="auto"
        height="auto"
        axis="row"
        justifyContent="flexStart"
        alignItems="center">

    <brls:Box
            wireframe="false"
            marginRight="4"
            height="100%"
            justifyContent="center"
            axis="column">
        <brls:Image
                id="userinfo/avatar"
                width="auto"
                maxHeight="90%"
                aspectRatio="1"
                scalingType="fit"
                marginLeft="4"
                borderThickness="4"
                borderColor="@theme/color/grey_1"
                cornerRadius="100"
                image="@res/pictures/default_avatar.png"/>
    </brls:Box>

    <brls:Box
            width="auto"
            height="100%"
            axis="column"
            grow="0"
            marginLeft="10"
            alignItems="flexStart">

        <brls:Box
                width="auto"
                height="auto"
                axis="row"
                alignItems="center">

        <brls:Label
                id="userinfo/label/username"
                width="auto"
                height="auto"
                wireframe="false"
                grow="1"
                fontSize="17"
                marginBottom="4"
                verticalAlign="center"
                singleLine="true"
                shrink="0"/>

    <brls:Box
            id="userinfo/box/hint"
            visibility="gone"
            width="77"
            height="26"
            marginLeft="16"
            cornerRadius="6"
            justifyContent="center"
            alignItems="center">
        <SVGImage
                id="userinfo/svg/hint"
                width="16"
                height="16"
                marginLeft="0"
                marginRight="2"/>
        <brls:Label
                id="userinfo/label/hint"
                textColor="@theme/font/grey"
                fontSize="15"
                marginTop="1"/>
    </brls:Box>
        </brls:Box>

        <brls:Label
                id="userinfo/label/misc"
                width="auto"
                height="auto"
                fontSize="15"
                grow="1"
                marginTop="4"
                verticalAlign="center"
                singleLine="true"
                shrink="0"
                wireframe="false"
                textColor="@theme/font/grey"/>

    </brls:Box>


</brls:Box>